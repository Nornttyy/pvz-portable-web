    "scale": "match native lawn baseline and card silhouette; validate at 1x, 1.5x and 2x",
    "files": "transparent RGBA PNG; one rig piece per file; use art/tech/<slug>/<part>-<state>.png"
  },
  "rig_contract": {
    "plant_common": ["body", "head", "face-blink", "stem", "leaf-back", "leaf-front", "mouth-or-tool", "shadow"],
    "zombie_common": ["body", "head", "jaw", "inner-upper-arm", "inner-lower-arm", "outer-upper-arm", "outer-lower-arm", "hand", "equipment", "shadow"],
    "mouth_rule": "Every shooter owns a dedicated living nozzle, maw, aperture or tool-end. When a borrowed native mouth pivot visibly separates in firing frames, the tool-end remains integrated with the complete custom head while independently drawn muzzle, projectile and impact layers carry the attack; it is never a recoloured legacy sprite.",
    "damage_rule": "Every unit supplies normal, damage1 and damage2 body states. Armour supplies armor, armor-damage1, armor-damage2 and detached-armor. Damage follows its construction with cracks, wilt, smoke or loose screws rather than a tint overlay.",
    "layer_order": "back appendages > body > head/face > mouth-or-tool > arms/equipment > foreground sparks/projectile"
  },
